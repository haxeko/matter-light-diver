# ---- ESP32-C6 : Matter over Thread, Wi-Fi disabled ----
CONFIG_ENABLE_WIFI_STATION=n
CONFIG_ENABLE_WIFI_AP=n
CONFIG_ESP_WIFI_ENABLED=n
CONFIG_ENABLE_MATTER_OVER_THREAD=y

# OpenThread (FTD so the mains-powered driver can act as a router)
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_FTD=y
CONFIG_OPENTHREAD_SRP_CLIENT=y
CONFIG_OPENTHREAD_DNS_CLIENT=y
CONFIG_OPENTHREAD_CLI=n
CONFIG_OPENTHREAD_LOG_LEVEL_DYNAMIC=n
CONFIG_OPENTHREAD_LOG_LEVEL_NOTE=y
CONFIG_OPENTHREAD_NUM_MESSAGE_BUFFERS=65
CONFIG_OPENTHREAD_RADIO_NATIVE=y
CONFIG_OPENTHREAD_DIAG=n

# IPv6 / lwIP as required by Thread
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=12
CONFIG_LWIP_MULTICAST_PING=y
CONFIG_LWIP_IPV6_FORWARD=n

# BLE only for commissioning
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_ESP_SYSTEM_PM_POWER_DOWN_CPU=n

# Memory
CONFIG_SPIRAM=n
